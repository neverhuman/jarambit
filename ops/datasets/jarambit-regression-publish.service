[Unit]
Description=Seal and commit Jarambit regression observations
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/jarambit/regression-publish.env
ExecStart=/opt/jarambit/bin/jarambit-datasets publish ${SPOOL_DIR} ${PUBLISH_CHECKOUT} ${PUBLISH_BRANCH} ${BATCH_ID}
User=jarambit-data
Group=jarambit-data
UMask=0027
TimeoutStartSec=180
Nice=15
CPUQuota=100%
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jarambit-regression-publisher

[Install]
WantedBy=multi-user.target
