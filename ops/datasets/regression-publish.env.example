# The service account needs read access to the spool and push access to only its data branch.
# Keep the dedicated Git checkout and credentials below the service's ReadWritePaths.
SPOOL_DIR=/var/lib/jarambit-regression-publisher/spool
PUBLISH_CHECKOUT=/var/lib/jarambit-regression-publisher/checkout
PUBLISH_BRANCH=data/regression-xbabe1
BATCH_ID=xbabe1-2026-10-20
